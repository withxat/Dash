{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "dash-relay",
	"main": "./src/worker/index.ts",
	"compatibility_date": "2026-07-01",
	"vars": {
		"APNS_TEAM_ID": "UH4FQTHMG2",
		"APNS_TOPIC": "sh.xat.dash.app"
	},
	"observability": {
		"enabled": true,
		"head_sampling_rate": 1,
		"logs": {
			// Legacy notify capabilities contain an APNs token in the path.
			// Keep status-only custom logs, but never persist request URLs.
			"invocation_logs": false
		}
	},
	"ratelimits": [
		{
			"name": "PUSH_REGISTRATION_GLOBAL_LIMITER",
			"namespace_id": "2026072801",
			"simple": {
				"limit": 300,
				"period": 60
			}
		},
		{
			"name": "PUSH_REGISTRATION_ACTOR_LIMITER",
			"namespace_id": "2026072802",
			"simple": {
				"limit": 30,
				"period": 60
			}
		}
	],
	"assets": {
		"not_found_handling": "single-page-application",
		"run_worker_first": ["/oauth/*", "/push/*", "/api/*", "/health"]
	}
}
