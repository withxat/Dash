{
	"extends": "@withxat/tsconfig",
	"compilerOptions": {
		"tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
		"jsx": "react-jsx",
		"lib": ["ES2025", "DOM", "DOM.Iterable"],
		"rootDir": ".",
		"module": "ESNext",
		"moduleResolution": "bundler",
		"types": ["vite/client"],
		"verbatimModuleSyntax": true
	},
	"include": ["src/client"]
}
