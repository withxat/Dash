# Cloudflare OAuth client id (public PKCE client — not secret).
# Create one in the Cloudflare dashboard: My Profile -> API Tokens -> Create OAuth Client.
EXPO_PUBLIC_CLOUDFLARE_CLIENT_ID=

# Registered https redirect URI for the CloudFX relay Worker
# (apps/relay-worker). Cloudflare only allows http(s) redirect URIs; the worker
# 302s the callback into the cloudfx:// scheme the app captures. Deploy the
# worker (`pnpm --filter @cloudfx/relay-worker deploy`), then set this to its
# /oauth/callback URL, e.g.
# https://cloudfx-relay.<your-subdomain>.workers.dev/oauth/callback
EXPO_PUBLIC_CLOUDFLARE_REDIRECT_URI=
