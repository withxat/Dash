{
	"expo": {
		"name": "CloudFX",
		"slug": "cloudfx",
		"version": "0.1.0",
		"orientation": "portrait",
		"userInterfaceStyle": "automatic",
		"scheme": "cloudfx",
		"splash": {
			"resizeMode": "contain",
			"backgroundColor": "#1a1a1a"
		},
		"assetBundlePatterns": ["**/*"],
		"ios": {
			"supportsTablet": true,
			"bundleIdentifier": "sh.xat.cloudfx"
		},
		"android": {
			"package": "sh.xat.cloudfx"
		},
		"web": {
			"bundler": "metro",
			"output": "single"
		},
		"plugins": [
			"expo-dev-client",
			"expo-router",
			[
				"expo-font",
				{
					"fonts": ["./assets/fonts/ChillRoundGothic_Heavy.otf"]
				}
			],
			[
				"expo-secure-store",
				{
					"faceIDPermission": "Use Face ID to authenticate CloudFX."
				}
			]
		],
		"extra": {
			"eas": {
				"projectId": ""
			}
		}
	}
}
